{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "easysavehd.vercel.app" }],
      "destination": "https://easysave.weblitex.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "easysavehd.vercel.app" }],
      "destination": "https://easysave.weblitex.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
